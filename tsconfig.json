{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@pg/*": ["./playground/src/*"],
      "react-wikitext": ["./src/index.ts"],
      "react-wikitext/ast": ["./src/ast/index.ts"],
      "react-wikitext/parse": ["./src/parse/index.ts"],
      "react-wikitext/expand": ["./src/expand/index.ts"],
      "react-wikitext/hast": ["./src/hast/index.ts"],
      "react-wikitext/unified": ["./src/unified/index.ts"],
      "react-wikitext/view": ["./src/view/index.ts"],
      "react-wikitext/configs": ["./src/configs/index.ts"],
      "react-wikitext/styles.css": ["./src/styles/view.css"]
    }
  },
  "include": [
    "src",
    "playground",
    "tests",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.bench.config.ts",
    "playwright.config.ts",
    "playwright.consumer.config.ts",
    "tsdown.config.ts",
    "website/rspress.config.ts",
    "website/theme"
  ],
  "exclude": ["dist", "node_modules", "tests/consumer/types", "tests/consumer/vite"]
}

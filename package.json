{
  "name": "react-wikitext",
  "version": "0.1.0-alpha.2",
  "description": "React components for rendering wikitext.",
  "keywords": [
    "hast",
    "mediawiki",
    "parser",
    "react",
    "renderer",
    "unified",
    "wiki",
    "wikitext"
  ],
  "homepage": "https://react-wikitext.pages.dev",
  "bugs": {
    "url": "https://github.com/BearBin1215/react-wikitext/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "React Wikitext contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearBin1215/react-wikitext.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "wikiparser-node": "1.48.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "entities": "8.1.0",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@10.34.9"
}

{
  "name": "react-wikitext",
  "version": "0.2.0",
  "description": "React components for rendering wikitext.",
  "keywords": [
    "hast",
    "mediawiki",
    "parser",
    "react",
    "renderer",
    "unified",
    "wiki",
    "wikitext"
  ],
  "homepage": "https://react-wikitext.pages.dev",
  "bugs": {
    "url": "https://github.com/BearBin1215/react-wikitext/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "React Wikitext contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearBin1215/react-wikitext.git"
  },
  "files": [
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ast": {
      "import": {
        "types": "./dist/ast.d.ts",
        "default": "./dist/ast.js"
      },
      "require": {
        "types": "./dist/ast.d.cts",
        "default": "./dist/ast.cjs"
      }
    },
    "./configs": {
      "import": {
        "types": "./dist/configs.d.ts",
        "default": "./dist/configs.js"
      },
      "require": {
        "types": "./dist/configs.d.cts",
        "default": "./dist/configs.cjs"
      }
    },
    "./expand": {
      "import": {
        "types": "./dist/expand.d.ts",
        "default": "./dist/expand.js"
      },
      "require": {
        "types": "./dist/expand.d.cts",
        "default": "./dist/expand.cjs"
      }
    },
    "./hast": {
      "import": {
        "types": "./dist/hast.d.ts",
        "default": "./dist/hast.js"
      },
      "require": {
        "types": "./dist/hast.d.cts",
        "default": "./dist/hast.cjs"
      }
    },
    "./parse": {
      "import": {
        "types": "./dist/parse.d.ts",
        "default": "./dist/parse.js"
      },
      "require": {
        "types": "./dist/parse.d.cts",
        "default": "./dist/parse.cjs"
      }
    },
    "./unified": {
      "import": {
        "types": "./dist/unified.d.ts",
        "default": "./dist/unified.js"
      },
      "require": {
        "types": "./dist/unified.d.cts",
        "default": "./dist/unified.cjs"
      }
    },
    "./view": {
      "import": {
        "types": "./dist/view.d.ts",
        "default": "./dist/view.js"
      },
      "require": {
        "types": "./dist/view.d.cts",
        "default": "./dist/view.cjs"
      }
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "play": "vite",
    "play:dist": "pnpm build && vite --mode dist",
    "docs:dev": "rspress dev --config website/rspress.config.ts",
    "docs:build": "rspress build --config website/rspress.config.ts",
    "docs:preview": "rspress preview --config website/rspress.config.ts",
    "build": "tsdown",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:dist": "pnpm build && node tests/consumer/check-cjs-externals.mjs && node tests/consumer/dist.test.mjs && node tests/consumer/dist.test.cjs && node tests/consumer/isolate-view.cjs && node tests/consumer/isolate-parse.cjs && node tests/consumer/isolate-expand.cjs && node tests/consumer/isolate-ast.cjs && node tests/consumer/isolate-hast.cjs && node tests/consumer/isolate-unified.cjs",
    "test:types:consumer": "tsc -p tests/consumer/types/tsconfig.node16.json && tsc -p tests/consumer/types/tsconfig.bundler.json",
    "test:vite": "vite build --config tests/consumer/vite/vite.config.mjs && node tests/consumer/vite/check.mjs",
    "test:webpack": "webpack --config tests/consumer/webpack/webpack.config.mjs && node tests/consumer/webpack/check.mjs",
    "test:view-only": "node tests/consumer/view-only/generate.mjs && vite build --config tests/consumer/view-only/vite.config.mjs && node tests/consumer/view-only/check.mjs",
    "test:view-only:webpack": "node tests/consumer/view-only/generate.mjs && webpack --config tests/consumer/view-only/webpack.config.mjs && node tests/consumer/view-only/check-webpack.mjs",
    "test:consumer": "pnpm test:dist && pnpm test:types:consumer && pnpm test:vite && pnpm test:webpack && pnpm test:view-only && pnpm test:view-only:webpack",
    "test:consumer:browser": "pnpm test:consumer && playwright test --config playwright.consumer.config.ts --grep \"@consumer\"",
    "test:a11y:build": "vite build --config tests/consumer/a11y/vite.config.mjs",
    "test:a11y": "pnpm build && pnpm test:a11y:build && playwright test --config playwright.consumer.config.ts --grep \"@a11y\"",
    "test:budget": "pnpm build && node tests/consumer/browser/generate-budget.mjs && playwright test --config playwright.consumer.config.ts --grep \"@budget\"",
    "bench": "vitest run --config vitest.bench.config.ts && node tests/performance/validate-report.mjs"
  },
  "dependencies": {
    "wikiparser-node": "1.48.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.64.1",
    "@rspress/core": "2.1.0",
    "@rspress/plugin-preview": "2.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "6.2.1",
    "bumpp": "12.3.0",
    "changelogithub": "15.0.5",
    "codemirror": "6.0.2",
    "entities": "8.1.0",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "jsdom": "30.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1"
  },
  "peerDependencies": {
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.34.9",
  "inlinedDependencies": {
    "@types/estree": "1.0.10",
    "@types/estree-jsx": "1.0.5",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "@ungap/structured-clone": "1.4.0",
    "bail": "2.0.2",
    "comma-separated-tokens": "2.0.3",
    "devlop": "1.1.0",
    "entities": "8.1.0",
    "estree-util-is-identifier-name": "3.0.0",
    "extend": "3.0.2",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-whitespace": "3.0.0",
    "inline-style-parser": "0.2.7",
    "is-plain-obj": "4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "micromark-util-types": "2.0.3",
    "property-information": "7.2.0",
    "space-separated-tokens": "2.0.2",
    "style-to-js": "1.1.21",
    "style-to-object": "1.0.14",
    "trough": "2.2.0",
    "unified": "11.0.5",
    "unist-util-position": "5.0.0",
    "unist-util-stringify-position": "4.0.0",
    "vfile": "6.0.3",
    "vfile-message": "4.0.3"
  }
}
